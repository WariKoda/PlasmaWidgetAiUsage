CLAUDE_CREDENTIALS = os.path.expanduser("~/.claude/.credentials.json")
CLAUDE_PROJECTS = os.path.expanduser("~/.claude/projects")
CLAUDE_USAGE_URL = "https://api.anthropic.com/api/oauth/usage"

CODEX_SESSIONS = os.path.expanduser("~/.codex/sessions")
CODEX_APP_SERVER_COMMAND = ["codex", "app-server", "--stdio"]
CODEX_SESSION_MAX_AGE = 900
CODEX_MAX_RESET_TIMESTAMP = 253_402_300_799  # 9999-12-31T23:59:59Z
CODEX_APP_SERVER_MAX_OUTPUT = 64 * 1024
CODEX_APP_SERVER_CLEANUP_TIMEOUT = 0.2

HTTP_TIMEOUT = 10

# Shared on-disk cache for the Claude usage API. Multiple widget instances
# (panel + desktop) read/write the same file, so the API is hit at most once per
# CLAUDE_OAUTH_POLL_INTERVAL regardless of how many instances poll -- this keeps us
# under the endpoint's rate limit (otherwise each instance polls independently
# and we get HTTP 429). On failure the last good response is served (marked
# stale) instead of dropping to a null estimate.
CACHE_DIR = os.path.expanduser("~/.cache/plasma-ai-usage")
CLAUDE_CACHE = os.path.join(CACHE_DIR, "claude-usage.json")
CLAUDE_OAUTH_LOCK = os.path.join(CACHE_DIR, "claude-oauth.lock")
CLAUDE_OAUTH_LOCK_TIMEOUT = 0.5
CLAUDE_STATUSLINE_CACHE = os.path.join(CACHE_DIR, "claude-statusline.json")
CLAUDE_INTEGRATION_STATE = os.path.join(CACHE_DIR, "claude-integration.json")
CLAUDE_SETTINGS = os.path.expanduser("~/.claude/settings.json")
CLAUDE_COLLECTOR = os.path.join(os.path.dirname(os.path.abspath(__file__)), "claude-usage-collector")
CLAUDE_COLLECTOR_MAX_AGE = 900
CLAUDE_OAUTH_POLL_INTERVAL = 900
CLAUDE_OAUTH_MAX_AGE = 3600
CLAUDE_MINIMUM_VERSION = (2, 1, 80)
CLAUDE_MAX_RESET_TIMESTAMP = 253_402_300_799  # 9999-12-31T23:59:59Z
MAX_SAFE_EXTERNAL_NUMBER = 1_000_000_000_000_000


# --------------------------------------------------------------------------- #
# Small helpers
# --------------------------------------------------------------------------- #
def env_str(name: str, default=None):
    val = os.environ.get(name)
    return val if val not in (None, "") else default


def env_int(name: str, default=None):
    val = os.environ.get(name)
    if val in (None, ""):
        return default
    try:
        return int(val)
    except ValueError:
        return default


def env_bool(name: str, default: bool) -> bool:
    val = os.environ.get(name)
    if val in (None, ""):
        return default
    return val.strip().lower() in ("1", "true", "yes", "on")


def read_json(path: str):
    try:
        with open(path, "r", encoding="utf-8") as fh:
            return json.load(fh)
    except (OSError, ValueError):
        return None


def atomic_write_json(path, obj, destination_dir):
    """Privately and atomically write JSON beneath an explicit directory."""
    os.makedirs(destination_dir, mode=0o700, exist_ok=True)
    os.chmod(destination_dir, 0o700)
    fd, temp_path = tempfile.mkstemp(prefix=".ai-usage-", dir=destination_dir)
    try:
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            fd = -1
            json.dump(obj, handle)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temp_path, path)
    finally:
        if fd >= 0:
            os.close(fd)
        try:
            os.unlink(temp_path)
        except FileNotFoundError:
            pass


def iso_to_epoch(value):
    """ISO-8601 string -> unix seconds (int) or None. Tolerates 'Z' suffix."""
    if not value:
        return None
    try:
        return int(datetime.fromisoformat(str(value).replace("Z", "+00:00")).timestamp())
    except (ValueError, TypeError):
        return None


def window(key, label, used_percent, resets_at, detail=None):
    win = {
        "key": key,
        "label": label,
        "used_percent": round(float(used_percent), 1) if used_percent is not None else None,
        "resets_at": int(resets_at) if resets_at is not None else None,
    }
    if detail:
        win["detail"] = detail
    return win


def valid_external_number(value, minimum=None, maximum=MAX_SAFE_EXTERNAL_NUMBER):
    """Accept bounded, finite JSON numbers while explicitly rejecting bool."""
    if isinstance(value, bool) or not isinstance(value, (int, float)):
        return False
    if isinstance(value, float) and not math.isfinite(value):
        return False
    return (minimum is None or value >= minimum) and (maximum is None or value <= maximum)


def valid_percentage(value):
    return valid_external_number(value, 0, 100)


def valid_reset_timestamp(value, allow_none=True):
    return ((allow_none and value is None) or
            valid_external_number(value, 0, CLAUDE_MAX_RESET_TIMESTAMP))


def format_decimal_amount(value, decimal_places=None, currency=None):
    if not isinstance(value, (int, float)):
        return None
    if isinstance(decimal_places, int) and decimal_places > 0:
        amount = value / (10 ** decimal_places)
        text = ("%%.%df" % decimal_places) % amount
    else:
        text = str(int(value)) if float(value).is_integer() else ("%.2f" % value).rstrip("0").rstrip(".")
    return "%s %s" % (text, currency) if currency else text


def provider(pid, label, available, source, plan, windows, error):
    return {
        "id": pid,
        "label": label,
        "available": available,
        "source": source,
        "plan": plan,
        "windows": windows,
        "error": error,
    }


def http_get_json(url, token, timeout=HTTP_TIMEOUT):
    req = urllib.request.Request(
        url,
        headers={
            "Authorization": "Bearer " + token,
            "Content-Type": "application/json",
            "User-Agent": "plasma-ai-usage",
        },
    )
    with urllib.request.urlopen(req, timeout=timeout) as resp:
        return json.loads(resp.read().decode("utf-8"))


def humanize_tokens(n):
    if n >= 1_000_000:
        return f"~{n / 1_000_000:.1f}M tok"
    if n >= 1_000:
        return f"~{n / 1_000:.0f}k tok"
    return f"~{n} tok"


def cache_age_is_valid(fetched_at, maximum_age, now):
    """Return true only for numeric timestamps from now-maximum_age through now."""
    if isinstance(fetched_at, bool) or not isinstance(fetched_at, (int, float)):
        return False
    return now - maximum_age <= fetched_at <= now


def unexpired_windows(windows, now):
    """Return windows with no reset or with resets_at strictly greater than now."""
    return [item for item in windows
            if item.get("resets_at") is None or item.get("resets_at") > now]


