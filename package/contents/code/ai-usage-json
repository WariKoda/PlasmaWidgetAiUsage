def env_str(name: str, default=None):
    val = os.environ.get(name)
    return val if val not in (None, "") else default


def env_int(name: str, default=None):
    val = os.environ.get(name)
    if val in (None, ""):
        return default
    try:
        return int(val)
    except ValueError:
        return default


def env_bool(name: str, default: bool) -> bool:
    val = os.environ.get(name)
    if val in (None, ""):
        return default
    return val.strip().lower() in ("1", "true", "yes", "on")


def claude_profile_id(path: str) -> str:
    digest = hashlib.sha256(os.path.realpath(path).encode("utf-8")).hexdigest()[:12]
    return "claude-" + digest


def default_claude_profile_label(path, home):
    name = os.path.basename(path)
    if os.path.realpath(path) == os.path.realpath(os.path.join(home, ".claude")):
        return "Claude"
    suffix = name[len(".claude-"):] if name.startswith(".claude-") else name
    words = re.split(r"[-_]+", suffix)
    return "Claude " + " ".join(word.capitalize() for word in words if word)


def has_claude_profile_marker(canonical_path):
    """Recognize profile markers only when each marker has its required type."""
    return (os.path.isfile(os.path.join(canonical_path, ".credentials.json")) or
            os.path.isfile(os.path.join(canonical_path, "settings.json")) or
            os.path.isdir(os.path.join(canonical_path, "projects")))


def validate_claude_profiles_config(raw_config: object):
    if not isinstance(raw_config, dict):
        raise ValueError("Claude profile configuration must be an object")
    unknown_keys = set(raw_config) - {"manual", "overrides"}
    if unknown_keys:
        raise ValueError("unknown Claude profile configuration key: %s" % sorted(unknown_keys)[0])

    manual = raw_config.get("manual", [])
    overrides = raw_config.get("overrides", {})
    if not isinstance(manual, list):
        raise ValueError("Claude profile configuration manual must be a list")
    if not isinstance(overrides, dict):
        raise ValueError("Claude profile configuration overrides must be an object")

    for index, entry in enumerate(manual):
        if not isinstance(entry, dict):
            raise ValueError("Claude profile manual entry %d must be an object" % index)
        if set(entry) != {"path"} or not isinstance(entry["path"], str) or not entry["path"].strip():
            raise ValueError("Claude profile manual entry %d must contain a non-empty path" % index)

    for path, override in overrides.items():
        if not isinstance(path, str) or not path:
            raise ValueError("Claude profile override path must be a non-empty string")
        if not isinstance(override, dict):
            raise ValueError("Claude profile override for %s must be an object" % path)
        unknown_override_keys = set(override) - {"label", "enabled"}
        if unknown_override_keys:
            raise ValueError("unknown Claude profile override key for %s: %s" % (
                path, sorted(unknown_override_keys)[0]))
        if "label" in override:
            if not isinstance(override["label"], str) or not override["label"].strip():
                raise ValueError("Claude profile override label for %s must be a non-empty string" % path)
        if "enabled" in override and not isinstance(override["enabled"], bool):
            raise ValueError("Claude profile override enabled for %s must be a boolean" % path)


def discover_claude_profiles(raw_config: object, home: str | None = None) -> list[dict]:
    validate_claude_profiles_config(raw_config)
    manual = raw_config.get("manual", [])
    overrides = {
        os.path.realpath(os.path.abspath(os.path.expanduser(path))): override
        for path, override in raw_config.get("overrides", {}).items()
    }
    home = os.path.realpath(os.path.abspath(os.path.expanduser(home or "~")))

    automatic = {}
    candidates = [os.path.join(home, ".claude")]
    candidates.extend(sorted(glob.glob(os.path.join(home, ".claude-*"))))
    for path in candidates:
        canonical_path = os.path.realpath(path)
        if not os.path.isdir(canonical_path):
            continue
        if not has_claude_profile_marker(canonical_path):
            continue
        automatic[canonical_path] = {
            "id": claude_profile_id(canonical_path),
            "base_provider": "claude",
            "label": default_claude_profile_label(path, home),
            "path": path,
            "canonical_path": canonical_path,
            "automatic": True,
            "enabled": True,
            "manual_paths": [],
        }

    manual_only = {}
    manual_order = []
    for entry in manual:
        raw_path = entry["path"]
        path = os.path.abspath(os.path.expanduser(raw_path))
        canonical_path = os.path.realpath(path)
        if canonical_path in automatic:
            automatic[canonical_path]["manual_paths"].append(raw_path)
            continue
        if canonical_path in manual_only:
            manual_only[canonical_path]["manual_paths"].append(raw_path)
            continue

        profile = {
            "id": claude_profile_id(canonical_path),
            "base_provider": "claude",
            "label": default_claude_profile_label(path, home),
            "path": path,
            "canonical_path": canonical_path,
            "automatic": False,
            "enabled": True,
            "manual_paths": [raw_path],
        }
        if not os.path.exists(canonical_path):
            profile["profile_error"] = "profile directory does not exist"
        elif not os.path.isdir(canonical_path):
            profile["profile_error"] = "profile path is not a directory"
        elif not has_claude_profile_marker(canonical_path):
            profile["profile_error"] = "profile marker not found"
        manual_only[canonical_path] = profile
        manual_order.append(canonical_path)

    profiles = [automatic[path] for path in sorted(automatic)]
    profiles.extend(manual_only[path] for path in manual_order)
    for profile in profiles:
        override = overrides.get(profile["canonical_path"])
        if override is None:
            continue
        if "label" in override:
            profile["label"] = override["label"].strip()
        if "enabled" in override:
            profile["enabled"] = override["enabled"]
    return profiles


def read_json(path: str):
    try:
        with open(path, "r", encoding="utf-8") as fh:
            return json.load(fh)
    except (OSError, ValueError):
        return None


def read_json_state(path: str, label="JSON file"):
    """Return (missing|valid|invalid|unreadable, value, explicit error)."""
    try:
        with open(path, "r", encoding="utf-8") as handle:
            return "valid", json.load(handle), None
    except FileNotFoundError:
        return "missing", None, None
    except (ValueError, UnicodeError) as exc:
        return "invalid", None, "%s is malformed: %s" % (label, exc)
    except OSError as exc:
        return "unreadable", None, "%s is unreadable: %s" % (label, exc)


def atomic_write_json(path, obj, destination_dir):
    """Privately and atomically write JSON beneath an explicit directory."""
    os.makedirs(destination_dir, mode=0o700, exist_ok=True)
    os.chmod(destination_dir, 0o700)
    fd, temp_path = tempfile.mkstemp(prefix=".ai-usage-", dir=destination_dir)
    try:
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            fd = -1
            json.dump(obj, handle)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temp_path, path)
    finally:
        if fd >= 0:
            os.close(fd)
        try:
            os.unlink(temp_path)
        except FileNotFoundError:
            pass


def atomic_create_json(path, obj, destination_dir):
    """Atomically publish private JSON only when path does not already exist."""
    os.makedirs(destination_dir, mode=0o700, exist_ok=True)
    os.chmod(destination_dir, 0o700)
    fd, temp_path = tempfile.mkstemp(prefix=".ai-usage-", dir=destination_dir)
    try:
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            fd = -1
            json.dump(obj, handle)
            handle.flush()
            os.fsync(handle.fileno())
        try:
            os.link(temp_path, path)
        except FileExistsError:
            return False
        return True
    finally:
        if fd >= 0:
            os.close(fd)
        try:
            os.unlink(temp_path)
        except FileNotFoundError:
            pass


def atomic_write_settings_json(path, obj):
    """Atomically update a canonical settings target without changing its modes."""
    destination_dir = os.path.dirname(path)
    existing_mode = os.stat(path).st_mode & 0o7777
    fd, temp_path = tempfile.mkstemp(prefix=".ai-usage-settings-", dir=destination_dir)
    try:
        os.fchmod(fd, existing_mode)
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            fd = -1
            json.dump(obj, handle)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temp_path, path)
    finally:
        if fd >= 0:
            os.close(fd)
        try:
            os.unlink(temp_path)
        except FileNotFoundError:
            pass


def iso_to_epoch(value):
    """ISO-8601 string -> unix seconds (int) or None. Tolerates 'Z' suffix."""
    if not value:
        return None
    try:
        return int(datetime.fromisoformat(str(value).replace("Z", "+00:00")).timestamp())
    except (ValueError, TypeError):
        return None


def window(key, label, used_percent, resets_at, detail=None):
    win = {
        "key": key,
        "label": label,
        "used_percent": round(float(used_percent), 1) if used_percent is not None else None,
        "resets_at": int(resets_at) if resets_at is not None else None,
    }
    if detail:
        win["detail"] = detail
    return win


def valid_external_number(value, minimum=None, maximum=MAX_SAFE_EXTERNAL_NUMBER):
    """Accept bounded, finite JSON numbers while explicitly rejecting bool."""
    if isinstance(value, bool) or not isinstance(value, (int, float)):
        return False
    if isinstance(value, float) and not math.isfinite(value):
        return False
    return (minimum is None or value >= minimum) and (maximum is None or value <= maximum)


def valid_percentage(value):
    return valid_external_number(value, 0, 100)


def valid_reset_timestamp(value, allow_none=True):
    return ((allow_none and value is None) or
            valid_external_number(value, 0, CLAUDE_MAX_RESET_TIMESTAMP))


def format_decimal_amount(value, decimal_places=None, currency=None):
    if not isinstance(value, (int, float)):
        return None
    if isinstance(decimal_places, int) and decimal_places > 0:
        amount = value / (10 ** decimal_places)
        text = ("%%.%df" % decimal_places) % amount
    else:
        text = str(int(value)) if float(value).is_integer() else ("%.2f" % value).rstrip("0").rstrip(".")
    return "%s %s" % (text, currency) if currency else text


def provider(pid, label, available, source, plan, windows, error, base_provider=None):
    result = {
        "id": pid,
        "label": label,
        "available": available,
        "source": source,
        "plan": plan,
        "windows": windows,
        "error": error,
    }
    if base_provider is not None:
        result["base_provider"] = base_provider
    return result


def http_get_json(url, token, timeout=HTTP_TIMEOUT):
    req = urllib.request.Request(
        url,
        headers={
            "Authorization": "Bearer " + token,
            "Content-Type": "application/json",
            "User-Agent": "plasma-ai-usage",
        },
    )
    with urllib.request.urlopen(req, timeout=timeout) as resp:
        return json.loads(resp.read().decode("utf-8"))


def humanize_tokens(n):
    if n >= 1_000_000:
        return f"~{n / 1_000_000:.1f}M tok"
    if n >= 1_000:
        return f"~{n / 1_000:.0f}k tok"
    return f"~{n} tok"


def cache_age_is_valid(fetched_at, maximum_age, now):
    """Return true only for numeric timestamps from now-maximum_age through now."""
    if isinstance(fetched_at, bool) or not isinstance(fetched_at, (int, float)):
        return False
    return now - maximum_age <= fetched_at <= now


def unexpired_windows(windows, now):
    """Return windows with no reset or with resets_at strictly greater than now."""
    return [item for item in windows
            if item.get("resets_at") is None or item.get("resets_at") > now]


