# Codex
# --------------------------------------------------------------------------- #
# Real event shape verified on disk (rate_limits lives under payload):
#   {"type": "event_msg", "timestamp": "...", "payload": {
#       "type": "token_count",
#       "rate_limits": {
#           "primary": {"used_percent": 13.0, "window_minutes": 10080, "resets_at": 1784694734},
#           "plan_type": "plus", ...}}}
def codex_window_identity(slot, window_minutes):
    """Return a stable key and readable label for a server-reported window."""
    fallback = (slot, slot.title())
    if isinstance(window_minutes, bool) or not isinstance(window_minutes, int) or window_minutes <= 0:
        return fallback
    if window_minutes % (24 * 60) == 0:
        amount = window_minutes // (24 * 60)
        return "%dd" % amount, "%d-Day" % amount
    if window_minutes % 60 == 0:
        amount = window_minutes // 60
        return "%dh" % amount, "%d-Hour" % amount
    return "%dm" % window_minutes, "%d-Minute" % window_minutes


def codex_extract_rate_limits(obj):
    """Pull the rate_limits block from a rollout line, tolerant of both the
    nested (payload.rate_limits) and a hypothetical top-level layout."""
    if not isinstance(obj, dict):
        return None
    payload = obj.get("payload")
    if isinstance(payload, dict) and payload.get("type") == "token_count":
        rl = payload.get("rate_limits")
        if isinstance(rl, dict):
            return rl
    if obj.get("type") == "token_count" and isinstance(obj.get("rate_limits"), dict):
        return obj["rate_limits"]
    return None


def codex_normalize_window(block, camel_case):
    """Normalize one Codex window, rejecting unsafe or fabricated values."""
    if not isinstance(block, dict):
        return None
    used_key = "usedPercent" if camel_case else "used_percent"
    minutes_key = "windowDurationMins" if camel_case else "window_minutes"
    reset_key = "resetsAt" if camel_case else "resets_at"
    used = block.get(used_key)
    resets = block.get(reset_key)
    if isinstance(used, bool) or not isinstance(used, (int, float)):
        return None
    if isinstance(used, float) and not math.isfinite(used):
        return None
    if used < 0 or used > 100:
        return None
    if isinstance(resets, bool) or not isinstance(resets, (int, float)):
        return None
    if isinstance(resets, float) and not math.isfinite(resets):
        return None
    if resets < 0 or resets > CODEX_MAX_RESET_TIMESTAMP:
        return None
    minutes = block.get(minutes_key)
    if camel_case and (
            isinstance(minutes, bool) or not isinstance(minutes, int) or minutes <= 0):
        return None
    return {
        "used_percent": float(used),
        "window_minutes": minutes,
        "resets_at": int(resets),
    }


def codex_normalize_rate_limits(snapshot, camel_case=True):
    """Validate and normalize app-server or local-session rate limits."""
    if not isinstance(snapshot, dict):
        return None
    normalized = {}
    plan = snapshot.get("planType" if camel_case else "plan_type")
    if isinstance(plan, str):
        normalized["plan_type"] = plan
    for slot in ("primary", "secondary"):
        block = codex_normalize_window(snapshot.get(slot), camel_case)
        if block is not None:
            normalized[slot] = block
    return normalized if "primary" in normalized or "secondary" in normalized else None


def codex_reap_process(process):
    """Close pipes and terminate, kill, and reap an app-server child."""
    if process.stdin is not None:
        try:
            process.stdin.close()
        except OSError:
            pass
    if process.poll() is None:
        try:
            process.terminate()
        except OSError:
            pass
        try:
            process.wait(timeout=CODEX_APP_SERVER_CLEANUP_TIMEOUT)
        except subprocess.TimeoutExpired:
            try:
                process.kill()
            except OSError:
                pass
            process.wait()
    for stream in (process.stdout, process.stderr):
        if stream is not None:
            try:
                stream.close()
            except OSError:
                pass


def codex_app_server_rate_limits(timeout=4):
    """Read Codex rate limits over newline-delimited JSON-RPC within one deadline."""
    process = None
    selector = None
    try:
        process = subprocess.Popen(
            CODEX_APP_SERVER_COMMAND,
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
        )
        requests = (
            {"id": 1, "method": "initialize", "params": {
                "clientInfo": {"name": "plasma-ai-usage", "version": "0.1.4"},
            }},
            {"id": 2, "method": "account/rateLimits/read", "params": None},
        )
        wire = b"".join((json.dumps(item, separators=(",", ":")) + "\n").encode("utf-8")
                        for item in requests)
        process.stdin.write(wire)
        process.stdin.flush()

        deadline = time.monotonic() + timeout
        selector = selectors.DefaultSelector()
        selector.register(process.stdout, selectors.EVENT_READ, "stdout")
        selector.register(process.stderr, selectors.EVENT_READ, "stderr")
        output = b""
        stderr = b""
        stdout_received = 0
        stderr_received = 0
        while True:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                return None, "Codex app-server timed out"
            events = selector.select(remaining)
            if not events:
                return None, "Codex app-server timed out"
            for key, _ in events:
                chunk = os.read(key.fileobj.fileno(), 65536)
                if not chunk:
                    selector.unregister(key.fileobj)
                    continue
                if key.data == "stderr":
                    stderr_received += len(chunk)
                    if stderr_received > CODEX_APP_SERVER_MAX_OUTPUT:
                        return None, "Codex app-server stderr exceeded size limit"
                    stderr += chunk
                    continue
                stdout_received += len(chunk)
                if stdout_received > CODEX_APP_SERVER_MAX_OUTPUT:
                    return None, "Codex app-server stdout exceeded size limit"
                output += chunk
                while b"\n" in output:
                    line, output = output.split(b"\n", 1)
                    if not line.strip():
                        continue
                    try:
                        response = json.loads(line.decode("utf-8"))
                    except (UnicodeError, ValueError):
                        return None, "Malformed Codex app-server JSON response"
                    if not isinstance(response, dict):
                        return None, "Malformed Codex app-server JSON response"
                    if response.get("id") != 2:
                        continue
                    if response.get("error") is not None:
                        return None, "Codex app-server error: %s" % response["error"]
                    result = response.get("result")
                    if not isinstance(result, dict):
                        return None, "Malformed Codex app-server rate-limit response"
                    by_id = result.get("rateLimitsByLimitId")
                    snapshot = by_id.get("codex") if isinstance(by_id, dict) else None
                    if snapshot is None:
                        snapshot = result.get("rateLimits")
                    normalized = codex_normalize_rate_limits(snapshot)
                    if normalized is None:
                        return None, "Malformed Codex app-server rate-limit response"
                    return normalized
            if process.poll() is not None and not selector.get_map():
                detail = stderr.decode("utf-8", errors="replace").strip()
                return None, "Codex app-server exited without rate limits%s" % (
                    ": " + detail if detail else "")
    except (OSError, subprocess.SubprocessError) as exc:
        return None, "Codex app-server unavailable: %s" % exc
    finally:
        if selector is not None:
            selector.close()
        if process is not None:
            codex_reap_process(process)


def codex_latest_rate_limits():
    """Newest rollout file (by mtime) that carries a rate_limits payload."""
    if not os.path.isdir(CODEX_SESSIONS):
        return None
    files = []
    for path in glob.iglob(os.path.join(CODEX_SESSIONS, "**", "rollout-*.jsonl"), recursive=True):
        try:
            files.append((os.path.getmtime(path), path))
        except OSError:
            continue
    files.sort(reverse=True)

    for _, path in files[:10]:  # scan the 10 most recent sessions at most
        rate_limits = None
        event_timestamp = None
        try:
            with open(path, "r", encoding="utf-8") as fh:
                for line in fh:
                    if '"rate_limits"' not in line:
                        continue
                    try:
                        obj = json.loads(line)
                    except ValueError:
                        continue
                    found = codex_extract_rate_limits(obj)
                    if found is not None:
                        rate_limits = found  # keep last (most recent in file)
                        timestamp = obj.get("timestamp")
                        if isinstance(timestamp, bool):
                            event_timestamp = None
                        elif isinstance(timestamp, (int, float)):
                            event_timestamp = timestamp
                        else:
                            event_timestamp = iso_to_epoch(timestamp)
        except OSError:
            continue
        if rate_limits and event_timestamp is not None:
            return {"rate_limits": rate_limits, "event_timestamp": event_timestamp}
    return None


def provider_codex(cfg):
    app_result = codex_app_server_rate_limits()
    if isinstance(app_result, tuple):
        rate_limits, app_error = app_result
    else:
        rate_limits, app_error = app_result, None
    source = "app-server"
    if not rate_limits:
        session = codex_latest_rate_limits()
        now = time.time()
        if (not isinstance(session, dict) or
                not cache_age_is_valid(session.get("event_timestamp"), CODEX_SESSION_MAX_AGE, now)):
            return provider("codex", "Codex", False, None, None, [],
                            app_error or "no fresh rate-limit data found in ~/.codex/sessions")
        rate_limits = session.get("rate_limits")
        source = "local-session"
    if not isinstance(rate_limits, dict):
        return provider("codex", "Codex", False, None, None, [],
                        app_error or "rate-limit data is malformed")
    rate_limits = codex_normalize_rate_limits(rate_limits, camel_case=False)
    if rate_limits is None:
        return provider("codex", "Codex", False, None, None, [],
                        app_error or "rate-limit payload has no usable windows")
    plan = rate_limits.get("plan_type")
    windows = []
    for slot in ("primary", "secondary"):
        blk = rate_limits.get(slot)
        if isinstance(blk, dict) and blk.get("used_percent") is not None:
            key, label = codex_window_identity(slot, blk.get("window_minutes"))
            windows.append(window(key, label, blk["used_percent"], blk.get("resets_at")))
    windows = unexpired_windows(windows, time.time())
    if not windows:
        return provider("codex", "Codex", False, None, plan, [],
                        "rate-limit payload present but no usable primary/secondary windows")
    return provider("codex", "Codex", True, source, plan, windows,
                    app_error if source == "local-session" else None)


# --------------------------------------------------------------------------- #
# Antigravity (successor to the Gemini CLI)
# --------------------------------------------------------------------------- #
# The Antigravity CLI/IDE runs a local "language server" (the `agy` process) that
# answers a Connect RPC with the real, signed-in quota -- the same data the IDE
# shows. There is no on-disk quota file and the cloud REST endpoint is locked down
# for consumer accounts, so this local server is the only honest source. It only
# runs while Antigravity is open and listens on a RANDOM localhost port per launch
# (discovered here via `ss`), so when Antigravity is not running we report the
# provider unavailable rather than guessing. Verified live: the RPC needs no CSRF
# token. Response shape (subset):
#   {"userStatus": {"planStatus": {"planInfo": {"planName": "Pro",
#         "monthlyPromptCredits": 50000}, "availablePromptCredits": 500},
#     "cascadeModelConfigData": {"clientModelConfigs": [
#         {"label": "...", "modelOrAlias": {"model": "..."},
#          "quotaInfo": {"remainingFraction": 1.0, "resetTime": "...Z"}}]}}}
ANTIGRAVITY_RPC_PATH = "/exa.language_server_pb.LanguageServerService/GetUserStatus"
ANTIGRAVITY_RPC_BODY = json.dumps(
    {"metadata": {"ideName": "antigravity", "extensionName": "antigravity", "locale": "en"}}
).encode("utf-8")
# Process names (from `ss` socket ownership) that identify the local server.
ANTIGRAVITY_PROC_HINTS = ("agy", "antigravity", "language_server", "language-server")
ANTIGRAVITY_CACHE_MAX_AGE = 600
# Last good getUserStatus, so we can still show the last-known quota (marked
# stale) after Antigravity is closed -- mirrors the Claude api-cached behaviour.
ANTIGRAVITY_CACHE = os.path.join(CACHE_DIR, "antigravity-usage.json")


def antigravity_listening_ports():
    """Localhost TCP ports owned by the running Antigravity server, via `ss`.
    Empty list when Antigravity is not running (or `ss` is unavailable)."""
    try:
        out = subprocess.run(
            ["ss", "-ltnpH"], capture_output=True, text=True, timeout=4
        ).stdout
    except (OSError, subprocess.SubprocessError):
        return []
    ports = []
    for line in out.splitlines():
        names = re.findall(r'\(\("([^"]+)"', line)
        if not any(any(h in n for h in ANTIGRAVITY_PROC_HINTS) for n in names):
            continue
        m = re.search(r"127\.0\.0\.1:(\d+)", line)
        if m:
            ports.append(int(m.group(1)))
    return ports


def antigravity_user_status():
    """Call the local Connect getUserStatus RPC on the discovered port(s).
    Returns the userStatus dict, or None when the server cannot be reached."""
    ctx = ssl._create_unverified_context()  # the server presents a self-signed cert
    for port in antigravity_listening_ports():
        for scheme in ("https", "http"):
            url = "%s://127.0.0.1:%d%s" % (scheme, port, ANTIGRAVITY_RPC_PATH)
            req = urllib.request.Request(
                url,
                data=ANTIGRAVITY_RPC_BODY,
                headers={
                    "Accept": "application/json",
                    "Content-Type": "application/json",
                    "Connect-Protocol-Version": "1",
                },
            )
            try:
                with urllib.request.urlopen(req, timeout=HTTP_TIMEOUT, context=ctx) as resp:
                    data = json.loads(resp.read().decode("utf-8"))
                    return data.get("userStatus", data)
            except Exception:  # noqa: BLE001 - wrong scheme/port -> try the next
                continue
    return None


def antigravity_build(us):
    """Map a userStatus dict to (plan, windows). Pure (no I/O), so it works the
    same on a live response or a cached one."""
    if not isinstance(us, dict):
        return None, []
    plan_status = us.get("planStatus") or {}
    if not isinstance(plan_status, dict):
        plan_status = {}
    plan_info = plan_status.get("planInfo") or {}
    if not isinstance(plan_info, dict):
        plan_info = {}
    plan = plan_info.get("planName")

    windows = []
    # Rolling per-model window: surface the most-constrained model (highest used %)
    # with its own reset time -- this is the "are you rate-limited right now" signal.
    worst = None
    cascade = us.get("cascadeModelConfigData") or {}
    model_cfgs = cascade.get("clientModelConfigs") or [] if isinstance(cascade, dict) else []
    if not isinstance(model_cfgs, list):
        model_cfgs = []
    for m in model_cfgs:
        if not isinstance(m, dict):
            continue
        qi = m.get("quotaInfo") or {}
        if not isinstance(qi, dict):
            continue
        rf = qi.get("remainingFraction")
        if not valid_external_number(rf, 0, 1):
            continue
        used = (1.0 - rf) * 100.0
        raw_reset = qi.get("resetTime")
        reset = iso_to_epoch(raw_reset) if isinstance(raw_reset, str) else raw_reset
        if not valid_reset_timestamp(reset, allow_none=raw_reset is None):
            continue
        if worst is None or used > worst[0]:
            worst = (used, m.get("label"), reset)
    if worst is not None:
        windows.append(window("models", "Models", worst[0], worst[2],
                              detail=worst[1] or None))

    # Monthly prompt-credit pool (a different time scale than the model windows).
    monthly = plan_info.get("monthlyPromptCredits")
    avail = plan_status.get("availablePromptCredits")
    if (valid_external_number(monthly, 0) and monthly > 0 and
            valid_external_number(avail, 0, monthly)):
        used = (monthly - avail) / monthly * 100.0
        windows.append(window("credits", "Credits", used, None,
                              detail="%d / %d credits" % (int(avail), int(monthly))))
    return plan, windows


def provider_antigravity(cfg):
    now = time.time()
    us = antigravity_user_status()

    # 1) Live: the agy server answered. Serve fresh and refresh the on-disk cache
    #    so we can still show the last-known state once Antigravity is closed.
    if us is not None:
        write_cache(ANTIGRAVITY_CACHE, {"fetched_at": now, "data": us})
        plan, windows = antigravity_build(us)
        windows = unexpired_windows(windows, now)
        if windows:
            return provider("antigravity", "Antigravity", True, "local-session", plan, windows, None)
        return provider("antigravity", "Antigravity", False, None, plan, [],
                        "user status returned no quota windows")

    # 2) Server unreachable (Antigravity not running): serve the last cached status
    #    -- explicitly marked stale, like the Claude api-cached path, never as fresh.
    cache = read_cache(ANTIGRAVITY_CACHE) or {}
    fetched_at = cache.get("fetched_at")
    if not cache_age_is_valid(fetched_at, ANTIGRAVITY_CACHE_MAX_AGE, now):
        if (not isinstance(fetched_at, bool) and
                isinstance(fetched_at, (int, float)) and
                (isinstance(fetched_at, int) or math.isfinite(fetched_at)) and
                0 <= fetched_at <= now):
            age = now - fetched_at
            return provider("antigravity", "Antigravity", False, None, None, [],
                            "Antigravity not running; cached usage is %ds old" % int(age))
        return provider("antigravity", "Antigravity", False, None, None, [],
                        "Antigravity not running; cached usage timestamp is invalid")
    cached = cache.get("data")
    if cached is not None:
        plan, windows = antigravity_build(cached)
        windows = unexpired_windows(windows, now)
        if windows:
            age = now - fetched_at
            note = "cached usage (%ds old) · Antigravity not running" % int(age)
            return provider("antigravity", "Antigravity", True, "local-cached", plan, windows, note)

    # 3) No live server and no cache yet.
    return provider("antigravity", "Antigravity", False, None, None, [],
                    "Antigravity not running (start the agy CLI or the IDE)")


